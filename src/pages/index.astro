---
import { getCollection, getEntry, render, type CollectionEntry } from 'astro:content';
import { isValidDate, formatDate } from '@/utils/markdown';
import { siteConfig, getPostCardAspectRatio } from '@/config';
import { generateHomeSEO } from '@/utils/seo';
import { shouldShowPost, shouldShowContent, sortPostsByDate, processPost } from '@/utils/markdown';
import { hasProjectCategories } from '@/utils/categories';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import Icon from '@/components/Icon.astro';
import { optimizeContentImagePath } from '@/utils/images';

const isDev = import.meta.env.DEV;

// Get posts page intro text from special collection
let postsPageContent: CollectionEntry<'special'>[] = [];
try {
  postsPageContent = await getCollection('special', ({ id }) => id === 'posts');
} catch (error) {
  postsPageContent = [];
}
const postsPageData = postsPageContent.length > 0 ? postsPageContent[0] : null;

// Get all posts and filter by visibility
const allPosts = await getCollection('posts');
const visiblePosts = allPosts.filter(post => shouldShowPost(post, isDev));
const sortedPosts = sortPostsByDate(visiblePosts);

// Process posts for reading time and word count
const processedPosts = await Promise.all(
  sortedPosts.map(async (post) => await processPost(post))
) as any[];

// Get recent posts (no featured post, just show most recent 3)
const recentPosts = processedPosts.slice(0, 3);

// Get featured projects if enabled
let featuredProjects: any[] = [];
let projectsHaveCategories = false;
if (siteConfig.homeOptions.projects.enabled && siteConfig.optionalContentTypes.projects) {
  const allProjects = await getCollection('projects');
  const visibleProjects = allProjects.filter(project => shouldShowContent(project, isDev));

  // Check if any projects have categories
  projectsHaveCategories = hasProjectCategories(visibleProjects);

  // First try to get featured projects
  const featuredOnly = visibleProjects.filter(project => project.data.featured);

  if (featuredOnly.length > 0) {
    // Show up to configured count of featured projects
            featuredProjects = featuredOnly
              .sort((a, b) => {
                const dateA = isValidDate(a.data.date) ? a.data.date : new Date(0);
                const dateB = isValidDate(b.data.date) ? b.data.date : new Date(0);
                return dateB.getTime() - dateA.getTime();
              })
              .slice(0, siteConfig.homeOptions.projects.count);
  } else if (visibleProjects.length > 0) {
    // Fallback to most recent projects if no featured ones
    featuredProjects = visibleProjects
      .sort((a, b) => {
        const dateA = isValidDate(a.data.date) ? a.data.date : new Date(0);
        const dateB = isValidDate(b.data.date) ? b.data.date : new Date(0);
        return dateB.getTime() - dateA.getTime();
      })
      .slice(0, siteConfig.homeOptions.projects.count);
  }
}

// Get featured publications
let featuredPublications: any[] = [];
const allPublications = await getCollection('publications');
const visiblePublications = allPublications.filter(publication => shouldShowContent(publication, isDev));

const featuredOnlyPublications = visiblePublications.filter(publication => publication.data.featured);

if (featuredOnlyPublications.length > 0) {
  featuredPublications = featuredOnlyPublications
    .sort((a, b) => {
      const dateA = isValidDate(a.data.date) ? a.data.date : new Date(0);
      const dateB = isValidDate(b.data.date) ? b.data.date : new Date(0);
      return dateB.getTime() - dateA.getTime();
    })
    .slice(0, 10);
} else if (visiblePublications.length > 0) {
  featuredPublications = visiblePublications
    .sort((a, b) => {
      const dateA = isValidDate(a.data.date) ? a.data.date : new Date(0);
      const dateB = isValidDate(b.data.date) ? b.data.date : new Date(0);
      return dateB.getTime() - dateA.getTime();
    })
    .slice(0, 10);
}

// Get home blurb content from special collection
let homeBlurbContent = null;
let HomeBlurbContent = null;

if (siteConfig.homeOptions.blurb.placement !== 'none') {
  try {
    homeBlurbContent = await getEntry('special', 'home');
    if (homeBlurbContent) {
      const { Content } = await render(homeBlurbContent);
      HomeBlurbContent = Content;
    }
  } catch (error) {
  }
}

// Determine which content types are being displayed
const hasRecentPosts = siteConfig.homeOptions.recentPosts.enabled && recentPosts.length > 0;
const hasProjects = siteConfig.homeOptions.projects.enabled && featuredProjects.length > 0;

// Count how many content types are being displayed
const contentTypesCount = [hasRecentPosts, hasProjects].filter(Boolean).length;

// Determine if we should use special treatment (only one content type is displayed)
const useSpecialTreatment = contentTypesCount === 1;

// Determine if only blurb content should be shown (no posts, projects, or docs)
const onlyBlurbContent = contentTypesCount === 0 && siteConfig.homeOptions.blurb.placement !== 'none' && HomeBlurbContent;

// Generate SEO data for homepage
const seoData = generateHomeSEO(Astro.url.href);

// Structured data for the website
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: siteConfig.title,
  description: siteConfig.description,
  url: siteConfig.site,
  author: {
    '@type': 'Person',
    name: siteConfig.author
  },
  publisher: {
    '@type': 'Organization',
    name: siteConfig.title,
    url: siteConfig.site
  }
};
---

<BaseLayout seoData={seoData}>
  <Fragment slot="head">
    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </Fragment>

  <div class="py-8 relative">
    <div class="mx-auto px-4 sm:px-6 lg:px-8" style={`max-width: ${siteConfig.layout.contentWidth}`}>
      <!-- Profile Section -->
      {siteConfig.homeOptions.profile.enabled && (
        <section class="mb-16">
          <div class="grid grid-cols-1 md:grid-cols-[auto_1fr] gap-8">
            <!-- Left Column: Photo and Social Icons -->
            <div class="flex flex-col items-center gap-4">
              <!-- Profile Photo -->
              <img
                src="/profile.jpg"
                alt="Xin Duan profile photo"
                class="w-40 h-40 md:w-44 md:h-44 rounded-xl object-cover shadow-lg"
              />

              <!-- Social Links -->
              <div class="flex flex-col items-stretch gap-2 w-full">
                <a 
                  href="mailto:duanxin926@gmail.com"
                  class="inline-flex items-center gap-2 px-3 py-1.5 text-sm font-medium rounded-lg bg-primary-100 dark:bg-primary-800 text-primary-700 dark:text-primary-300 hover:bg-highlight-100 dark:hover:bg-highlight-900/40 hover:text-highlight-800 dark:hover:text-highlight-200 transition-all duration-200 hover:scale-105"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                  <span>Email</span>
                </a>
                
                <a 
                  href="https://scholar.google.com/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-3 py-1.5 text-sm font-medium rounded-lg bg-primary-100 dark:bg-primary-800 text-primary-700 dark:text-primary-300 hover:bg-highlight-100 dark:hover:bg-highlight-900/40 hover:text-highlight-800 dark:hover:text-highlight-200 transition-all duration-200 hover:scale-105"
                >
                  <Icon name="book-open" class="w-4 h-4" />
                  <span>Google Scholar</span>
                </a>
                
                <a 
                  href="https://x.com/xinduan926"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-3 py-1.5 text-sm font-medium rounded-lg bg-primary-100 dark:bg-primary-800 text-primary-700 dark:text-primary-300 hover:bg-highlight-100 dark:hover:bg-highlight-900/40 hover:text-highlight-800 dark:hover:text-highlight-200 transition-all duration-200 hover:scale-105"
                >
                  <Icon name="x-twitter" class="w-4 h-4" />
                  <span>X (former Twitter)</span>
                </a>
                
                <a
                  href="https://github.com/duanxin926"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-3 py-1.5 text-sm font-medium rounded-lg bg-primary-100 dark:bg-primary-800 text-primary-700 dark:text-primary-300 hover:bg-highlight-100 dark:hover:bg-highlight-900/40 hover:text-highlight-800 dark:hover:text-highlight-200 transition-all duration-200 hover:scale-105"
                >
                  <Icon name="github" class="w-4 h-4" />
                  <span>GitHub</span>
                </a>

                <a
                  href="https://www.linkedin.com/in/xin-duan-b737a0338/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-3 py-1.5 text-sm font-medium rounded-lg bg-primary-100 dark:bg-primary-800 text-primary-700 dark:text-primary-300 hover:bg-highlight-100 dark:hover:bg-highlight-900/40 hover:text-highlight-800 dark:hover:text-highlight-200 transition-all duration-200 hover:scale-105"
                >
                  <Icon name="linkedin-in" class="w-4 h-4" />
                  <span>LinkedIn</span>
                </a>

                <a
                  href="https://maps.google.com/?q=Shanghai"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-3 py-1.5 text-sm font-medium rounded-lg bg-primary-100 dark:bg-primary-800 text-primary-700 dark:text-primary-300 hover:bg-highlight-100 dark:hover:bg-highlight-900/40 hover:text-highlight-800 dark:hover:text-highlight-200 transition-all duration-200 hover:scale-105"
                >
                  <Icon name="map-pin" class="w-4 h-4" />
                  <span>Shanghai, China</span>
                </a>
              </div>
            </div>

            <!-- Right Column: Name and Description in Light Box -->
            <div class="bg-primary-50 dark:bg-primary-900/30 rounded-2xl p-8 border border-primary-200 dark:border-primary-700">
              <!-- Name -->
              <div class="mb-6">
                <h1 class="text-2xl md:text-4xl font-bold text-primary-900 dark:text-primary-50 mb-2">
                  Xin Duan
                </h1>
                <p class="text-xl md:text-2xl text-primary-700 dark:text-primary-300">
                  段欣
                </p>
              </div>

              <!-- Description -->
              <div class="space-y-4 text-primary-800 dark:text-primary-200 text-l leading-relaxed">
                <p>
                  I am a third-year Master student in the <a href="https://robotics.shanghaitech.edu.cn/" target="_blank" class="text-highlight-600 dark:text-highlight-400 hover:underline font-medium">MARS Lab</a> at <span class="font-semibold text-primary-900 dark:text-primary-100">ShanghaiTech University</span>, advised by <a href="https://robotics.shanghaitech.edu.cn/" target="_blank" class="text-highlight-600 dark:text-highlight-400 hover:underline font-medium">Prof. Sören Schwertfeger</a>. My research interest is focused on <span class="font-semibold text-primary-900 dark:text-primary-100">Embodied AI</span>.
                </p>
                <p>
                  I also received my Bachelor's degree in Computer Science and Technology from ShanghaiTech.
                </p>
                <p>
                  Previously, I was a student researcher at the <span class="font-semibold text-primary-900 dark:text-primary-100">Shanghai Qi Zhi Institute</span> under the supervision of <a href="https://hangzhaomit.github.io/" target="_blank" class="text-highlight-600 dark:text-highlight-400 hover:underline font-medium">Prof. Hang Zhao</a> and an R&D intern at <span class="font-semibold text-primary-900 dark:text-primary-100">Fourier Intelligence</span>.
                </p>
              </div>
            </div>
          </div>
        </section>
      )}

      <!-- Publications Section -->
      {featuredPublications.length > 0 && (
        <section class="mb-16">
          <h2 class="text-2xl font-semibold text-primary-900 dark:text-primary-50 mb-8">
            Publications
          </h2>
          <div class="space-y-6">
            {featuredPublications.map((publication) => {
              let imagePath = publication.data.image;
              if (typeof imagePath === 'string' && imagePath.startsWith('[[') && imagePath.endsWith(']]')) {
                imagePath = imagePath.slice(2, -2);
              }
              const optimizedImage = imagePath ? optimizeContentImagePath(
                imagePath,
                'publications',
                publication.id,
                publication.id
              ) : null;
              
              return (
                <article class="group post-card" role="article">
                  <a 
                    href={publication.data.demoUrl || `/publications/${publication.id}`}
                    class="block"
                    target={publication.data.demoUrl ? "_blank" : undefined}
                    rel={publication.data.demoUrl ? "noopener noreferrer" : undefined}
                  >
                    {optimizedImage && (
                      <div class="overflow-hidden rounded-t-lg bg-primary-100 dark:bg-primary-800" style={`aspect-ratio: ${getPostCardAspectRatio()};`}>
                        <img
                          src={optimizedImage}
                          alt={publication.data.imageAlt || `Cover image for ${publication.data.title}`}
                          class="w-full h-full object-cover group-hover:scale-102 dark:group-hover:brightness-100 transition-all duration-300"
                          loading="lazy"
                        />
                      </div>
                    )}
                    
                    <div class={`p-4 ${optimizedImage ? 'rounded-b-lg' : 'rounded-lg'}`}>
                      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-primary-500 dark:text-primary-400 mb-1">
                        {isValidDate(publication.data.date) && (
                          <time datetime={publication.data.date.toISOString()}>
                            {formatDate(publication.data.date)}
                          </time>
                        )}
                        {publication.data.categories && publication.data.categories.length > 0 && (
                          <>
                            <span class="text-primary-300 dark:text-primary-600">•</span>
                            <span>{publication.data.categories[0]}</span>
                          </>
                        )}
                      </div>

                      <h3 class="text-lg font-medium text-primary-900 dark:text-primary-100 leading-relaxed group-hover:text-highlight-600 dark:group-hover:text-highlight-400 transition-colors">
                        {publication.data.title}
                      </h3>

                      {publication.data.authors && (
                        <p 
                          class="text-primary-600 dark:text-primary-300 text-sm leading-relaxed mt-1"
                          set:html={publication.data.authors.replace('Xin Duan', '<strong>Xin Duan</strong>')}
                        />
                      )}

                      {publication.data.venue && (
                        <p class="text-primary-500 dark:text-primary-400 text-sm font-medium mt-1">
                          {publication.data.venue}
                        </p>
                      )}

                      <div class="flex flex-wrap items-center gap-2 mt-3">
                        {publication.data.arXiv && (
                          <a 
                            href={publication.data.arXiv}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-full bg-primary-100 dark:bg-primary-800 text-primary-700 dark:text-primary-300 hover:bg-highlight-100 dark:hover:bg-highlight-900/40 hover:text-highlight-800 dark:hover:text-highlight-200 transition-all duration-200 hover:scale-105"
                            onclick="event.stopPropagation()"
                          >
                            <Icon name="file-text" class="w-3.5 h-3.5" />
                            arXiv
                          </a>
                        )}
                        {publication.data.demoUrl && (
                          <a 
                            href={publication.data.demoUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-full bg-primary-100 dark:bg-primary-800 text-primary-700 dark:text-primary-300 hover:bg-highlight-100 dark:hover:bg-highlight-900/40 hover:text-highlight-800 dark:hover:text-highlight-200 transition-all duration-200 hover:scale-105"
                            onclick="event.stopPropagation()"
                          >
                            <Icon name="external-link" class="w-3.5 h-3.5" />
                            website
                          </a>
                        )}
                        {publication.data.repositoryUrl && (
                          <a 
                            href={publication.data.repositoryUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-full bg-primary-100 dark:bg-primary-800 text-primary-700 dark:text-primary-300 hover:bg-highlight-100 dark:hover:bg-highlight-900/40 hover:text-highlight-800 dark:hover:text-highlight-200 transition-all duration-200 hover:scale-105"
                            onclick="event.stopPropagation()"
                          >
                            <Icon name="github" class="w-3.5 h-3.5" />
                            code
                          </a>
                        )}
                      </div>
                    </div>
                  </a>
                </article>
              );
            })}
          </div>
        </section>
      )}

      <!-- Featured Projects -->
      {siteConfig.homeOptions.projects.enabled && featuredProjects.length > 0 && (
        <section class="mb-16">
          <h2 class="text-2xl font-semibold text-primary-900 dark:text-primary-50 mb-8">
            Projects
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {featuredProjects.map((project, index) => (
              <ProjectCard project={project} eager={false} context="home" showCategories={projectsHaveCategories} />
            ))}
          </div>
        </section>
      )}

      <!-- Recent Posts -->
      <!-- {siteConfig.homeOptions.recentPosts.enabled && recentPosts.length > 0 && (
        <section class="mb-16">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-2xl font-semibold text-primary-900 dark:text-primary-50">
              Recent Blogs
            </h2>
            <a
              href="/posts"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 text-s font-medium rounded-full bg-primary-100 dark:bg-primary-800 text-primary-700 dark:text-primary-300 hover:bg-highlight-100 dark:hover:bg-highlight-900/40 hover:text-highlight-800 dark:hover:text-highlight-200 transition-all duration-200 hover:scale-110"
            >
              <span>More</span>
              <Icon name="arrow-right" class="w-5 h-5" />
            </a>
          </div>
          {postsPageData?.data.intro && (
            <p class="text-base text-primary-600 dark:text-primary-300 mb-8">
              {postsPageData.data.intro}
            </p>
          )}
          <div class="space-y-6">
            {recentPosts.map((post, index) => (
              <PostCard post={post} eager={index === 0} context="recent" />
            ))}
          </div>
        </section>
      )} -->


    </div>
  </div>
</BaseLayout>

<script>
  // Hero search button functionality
  document.addEventListener('DOMContentLoaded', () => {
    const heroSearchButton = document.getElementById('hero-search-button');

    if (heroSearchButton) {
      heroSearchButton.addEventListener('click', () => {
        const event = new CustomEvent('openCommandPalette');
        window.dispatchEvent(event);
      });
    }
  });
</script>

<style>
  /* Enhanced homepage styles */
  .btn-primary {
    @apply inline-flex items-center px-6 py-3 font-medium rounded-lg transition-all duration-200 hover:shadow-lg transform hover:scale-105;
  }

  .btn-primary:focus-visible {
    @apply outline-none ring-2 ring-highlight-500 ring-offset-2;
  }
</style>
