---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '@/config';
import { shouldShowPost, sortPostsByDate, extractTags } from '@/utils/markdown';
import { hasPostCategories, getPostCategories } from '@/utils/categories';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import Tags from '@/components/Tags.astro';
import PostCategories from '@/components/PostCategories.astro';
import Pagination from '@/components/Pagination.astro';
import Icon from '@/components/Icon.astro';
import { HIDE_BLOG_LISTING_PAGES } from '@/utils/visibility';

export const getStaticPaths: GetStaticPaths = async () => {
  if (HIDE_BLOG_LISTING_PAGES) {
    return [];
  }

  const isDev = import.meta.env.DEV;
  
  try {
    // Get all posts
    const allPosts = await getCollection('posts');
    const visiblePosts = allPosts.filter(post => shouldShowPost(post, isDev));
    const sortedPosts = sortPostsByDate(visiblePosts);

    // Extract all unique categories with error handling
    const postsHaveCategories = hasPostCategories(sortedPosts);
    const allCategories = postsHaveCategories ? getPostCategories(sortedPosts) : [];

    if (isDev && allCategories.length === 0) {
    }

    // Extract all tags for sidebar
    const allTags = extractTags(sortedPosts);

    const postsPerPage = siteConfig.postOptions.postsPerPage;
    const paths: any[] = [];

    // Generate paths for each category and its pagination
    for (const category of allCategories) {
      try {
        const categoryPosts = sortedPosts.filter(post => {
          if (!post.data.categories) return false;
          const postCategories = Array.isArray(post.data.categories) ? post.data.categories : [post.data.categories];
          return postCategories.some((postCategory: any) => 
            postCategory && typeof postCategory === 'string' && postCategory.trim() === category.trim()
          );
        });
        const totalPages = Math.ceil(categoryPosts.length / postsPerPage);

        for (let page = 2; page <= totalPages; page++) {
          paths.push({
            params: { category: category, page: page.toString() },
            props: { allPosts: sortedPosts, allCategories, allTags, currentPage: page }
          });
        }
        } catch (error) {
          if (isDev) {
          }
          // Continue with other categories
        }
    }

    return paths;
  } catch (error) {
    if (isDev) {
    }
    return [];
  }
};

if (HIDE_BLOG_LISTING_PAGES) {
  return Astro.redirect('/404');
}

const { allPosts, allCategories, allTags, currentPage } = Astro.props as {
  allPosts: any[];
  allCategories: string[];
  allTags: string[];
  currentPage: number;
};
const isDev = import.meta.env.DEV;

// Get category from route params (catch-all route returns array or string)
const categoryParam = Astro.params.category;
let category: string;
if (Array.isArray(categoryParam)) {
  category = categoryParam.join('/');
} else if (typeof categoryParam === 'string') {
  category = categoryParam;
} else if (typeof categoryParam === 'number') {
  category = categoryParam.toString();
} else {
  category = '';
}

// Validate category parameter
if (!category || category.trim() === '') {
  if (isDev) {
  }
  // Return 404 or redirect in production, show error in dev
  if (!isDev) {
    return Astro.redirect('/404');
  }
}

// Trim the category
category = category.trim();

// Filter posts by the current category with error handling
let filteredPosts: any[] = [];
try {
  filteredPosts = allPosts.filter((post: any) => {
    if (!post.data.categories) return false;
    
    // Handle both string and array categories
    const postCategories = Array.isArray(post.data.categories) ? post.data.categories : [post.data.categories];
    return postCategories.some((postCategory: any) => 
      postCategory && typeof postCategory === 'string' && postCategory.trim() === category.trim()
    );
  });
} catch (error) {
  if (isDev) {
  }
  filteredPosts = [];
}

// Pagination
const postsPerPage = siteConfig.postOptions.postsPerPage;
const totalPosts = filteredPosts.length;
const totalPages = Math.ceil(totalPosts / postsPerPage);
const startIndex = (currentPage - 1) * postsPerPage;
const endIndex = Math.min(startIndex + postsPerPage, totalPosts);
const paginatedPosts = filteredPosts.slice(startIndex, endIndex);

// Generate SEO data
const pageTitle = `分类：${category} - 第 ${currentPage} 页`;
const pageDescription = `第 ${currentPage} 页，分类为 "${category}" 的文章`;

const seoData = {
  title: `${pageTitle} | ${siteConfig.title}`,
  description: pageDescription,
  canonical: Astro.url.href,
  ogType: 'website' as const
};

// Pagination info
const baseUrl = `/posts/category/${encodeURIComponent(category)}`;
const pagination = {
  currentPage,
  totalPages,
  hasNext: currentPage < totalPages,
  hasPrev: currentPage > 1,
  nextUrl: currentPage < totalPages ? `${baseUrl}/${currentPage + 1}` : undefined,
  prevUrl: currentPage > 1 ? (currentPage === 2 ? baseUrl : `${baseUrl}/${currentPage - 1}`) : undefined
};
---

<BaseLayout seoData={seoData}>
  <div class="py-8 relative">
    <div class="mx-auto px-4 sm:px-6 lg:px-8 mb-12" style={`max-width: ${siteConfig.layout.contentWidth}`}>
      <!-- Header -->
      <header class="mb-8">
        <div class="flex items-start justify-between mb-3">
          <h1 class="font-bold text-primary-900 dark:text-primary-50">
            分类：{category}
          </h1>
          <div class="flex items-center space-x-2">
            <a 
              href="/rss.xml"
              class="inline-flex items-center px-3 py-2 text-sm font-medium text-highlight-600 dark:text-highlight-400 bg-highlight-50 dark:bg-highlight-900/20 rounded-lg border border-highlight-200 dark:border-highlight-700 hover:bg-highlight-100 dark:hover:bg-highlight-900/40 hover:text-highlight-700 dark:hover:text-highlight-300 transition-all duration-200"
              title="Subscribe to RSS feed"
              data-no-swup
            >
              <Icon name="rss" class="w-4 h-4 mr-1.5" />
              RSS Feed
            </a>
            <!-- <a 
              href="/feed.xml"
              class="inline-flex items-center px-3 py-2 text-sm font-medium text-highlight-600 dark:text-highlight-400 bg-highlight-50 dark:bg-highlight-900/20 rounded-lg border border-highlight-200 dark:border-highlight-700 hover:bg-highlight-100 dark:hover:bg-highlight-900/40 hover:text-highlight-700 dark:hover:text-highlight-300 transition-all duration-200"
              title="Subscribe to Atom feed"
              data-no-swup
            >
              <Icon name="atom" class="w-4 h-4 mr-1.5" />
              Atom Feed
            </a> -->
          </div>
        </div>
        <p class="text-base text-primary-600 dark:text-primary-300">
          第 {currentPage} 页，共 {totalPages} 页 • <strong>{filteredPosts.length}</strong> 篇文章，分类为
          <span class="inline-flex items-center px-2 py-1 bg-highlight-100 dark:bg-highlight-900/30 text-highlight-800 dark:text-highlight-200 rounded text-sm font-medium ml-1">
            {category}
          </span>
        </p>

        <div class="mt-4">
          <a 
            href="/posts"
            class="inline-flex items-center text-sm text-primary-600 dark:text-primary-300 hover:text-primary-800 dark:hover:text-primary-200 transition-colors"
          >
            <Icon name="arrow-left" class="w-4 h-4 mr-1" />
            显示所有文章
          </a>
        </div>
      </header>

      <div class="relative">
        <!-- Mobile sidebar - appears above content on mobile/tablet -->
        <div class="xl:hidden mb-8 flex flex-col sm:flex-row gap-4">
          <!-- Categories -->
          {siteConfig.postOptions.tags && allCategories.length > 0 && (
            <div class="flex-1 min-w-0">
              <PostCategories categories={allCategories} currentCategory={category} currentTag={undefined} />
            </div>
          )}
          <!-- Tags -->
          {siteConfig.postOptions.tags && allTags.length > 0 && (
            <div class="flex-1 min-w-0">
              <Tags tags={allTags} currentTag={undefined} currentCategory={category} />
            </div>
          )}
        </div>

        <!-- Main content -->
        <div class="max-w-none">
          <!-- Posts list -->
          <div class="space-y-6 mb-12">
            {paginatedPosts.map((post, index) => (
              <PostCard post={post} context="tags" eager={index < 2} />
            ))}
          </div>

          <!-- Pagination -->
          <Pagination pagination={pagination} baseUrl={baseUrl} />
        </div>

        <!-- Desktop sidebar - floats to the right of the content container -->
        <div class="hidden xl:block absolute top-0 left-full ml-8 w-64">
          <div class="sticky top-24 space-y-3 max-h-[calc(100vh-12rem)] overflow-y-auto pb-6">
            <!-- Categories -->
            {siteConfig.postOptions.tags && allCategories.length > 0 && (
              <PostCategories categories={allCategories} currentCategory={category} currentTag={undefined} />
            )}
            <!-- Tags -->
            {siteConfig.postOptions.tags && allTags.length > 0 && (
              <Tags tags={allTags} currentTag={undefined} currentCategory={category} />
            )}
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
